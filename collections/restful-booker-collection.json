{
	"info": {
		"_postman_id": "7a3a9b2b-6b21-4f4e-a123-restful-booker",
		"name": "Restful Booker API Test Suite",
		"description": "Comprehensive E2E REST API Testing suite with assertions, token management, schema validation, and negative testing.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Create Token (Auth)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains token\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('token');",
							"    pm.collectionVariables.set(\"token\", jsonData.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "https://restful-booker.herokuapp.com/auth",
					"protocol": "https",
					"host": ["restful-booker", "herokuapp", "com"],
					"path": ["auth"]
				}
			}
		},
		{
			"name": "2. Create Booking (POST)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 Created\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is within acceptable limits (< 1500ms)\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(1500);",
							"});",
							"",
							"pm.test(\"Verify Booking Details & Extract ID\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('bookingid');",
							"    pm.expect(jsonData.booking.firstname).to.eql(\"Om\");",
							"    pm.expect(jsonData.booking.lastname).to.eql(\"Anand\");",
							"    pm.expect(jsonData.booking.totalprice).to.eql(150);",
							"    pm.collectionVariables.set(\"bookingId\", jsonData.bookingid);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"firstname\": \"Om\",\n    \"lastname\": \"Anand\",\n    \"totalprice\": 150,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-10\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}"
				},
				"url": {
					"raw": "https://restful-booker.herokuapp.com/booking",
					"protocol": "https",
					"host": ["restful-booker", "herokuapp", "com"],
					"path": ["booking"]
				}
			}
		},
		{
			"name": "3. Get Booking Details (GET)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Validate JSON Schema Contract\", function () {",
							"    var schema = {",
							"        \"type\": \"object\",",
							"        \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
							"        \"properties\": {",
							"            \"firstname\": { \"type\": \"string\" },",
							"            \"lastname\": { \"type\": \"string\" },",
							"            \"totalprice\": { \"type\": \"number\" },",
							"            \"depositpaid\": { \"type\": \"boolean\" },",
							"            \"bookingdates\": {",
							"                \"type\": \"object\",",
							"                \"required\": [\"checkin\", \"checkout\"],",
							"                \"properties\": {",
							"                    \"checkin\": { \"type\": \"string\" },",
							"                    \"checkout\": { \"type\": \"string\" }",
							"                }",
							"            }",
							"        }",
							"    };",
							"    pm.response.to.have.jsonSchema(schema);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://restful-booker.herokuapp.com/booking/{{bookingId}}",
					"protocol": "https",
					"host": ["restful-booker", "herokuapp", "com"],
					"path": ["booking", "{{bookingId}}"]
				}
			}
		},
		{
			"name": "4. Update Booking (PUT)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK after Update\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Verify Updated Price and Need\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.totalprice).to.eql(200);",
							"    pm.expect(jsonData.additionalneeds).to.eql(\"Late Checkout\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Cookie",
						"value": "token={{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"firstname\": \"Om\",\n    \"lastname\": \"Anand\",\n    \"totalprice\": 200,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-10\"\n    },\n    \"additionalneeds\": \"Late Checkout\"\n}"
				},
				"url": {
					"raw": "https://restful-booker.herokuapp.com/booking/{{bookingId}}",
					"protocol": "https",
					"host": ["restful-booker", "herokuapp", "com"],
					"path": ["booking", "{{bookingId}}"]
				}
			}
		},
		{
			"name": "5. Delete Booking (DELETE)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created/Deleted\", function () {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Cookie",
						"value": "token={{token}}"
					}
				],
				"url": {
					"raw": "https://restful-booker.herokuapp.com/booking/{{bookingId}}",
					"protocol": "https",
					"host": ["restful-booker", "herokuapp", "com"],
					"path": ["booking", "{{bookingId}}"]
				}
			}
		},
		{
			"name": "6. Negative Test - Verify Deleted ID (GET)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 Not Found\", function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://restful-booker.herokuapp.com/booking/{{bookingId}}",
					"protocol": "https",
					"host": ["restful-booker", "herokuapp", "com"],
					"path": ["booking", "{{bookingId}}"]
				}
			}
		}
	],
	"variable": [
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "bookingId",
			"value": ""
		}
	]
}